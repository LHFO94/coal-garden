{
  "name": "coal-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:worker": "wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "agents": "0.33.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "@earendil-works/chord": {
      "react": "$react"
    },
    "workerd": "1.20261115.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.1",
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
